{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vin25cent/Scrib/Schemas/course-generation-v1.schema.json",
  "title": "Scrib course generation envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "courseID", "documents", "sources"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "courseID": { "type": "string", "format": "uuid" },
    "documents": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "$ref": "#/$defs/document" }
    },
    "sources": {
      "type": "array",
      "maxItems": 200,
      "items": { "$ref": "#/$defs/source" }
    }
  },
  "$defs": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "value"],
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 100 },
        "value": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "authority", "title", "canonicalURL", "verifiedAt"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,80}$" },
        "authority": { "type": "string", "minLength": 1, "maxLength": 300 },
        "title": { "type": "string", "minLength": 1, "maxLength": 500 },
        "canonicalURL": { "type": "string", "format": "uri", "pattern": "^https://" },
        "verifiedAt": { "type": "string", "format": "date-time" }
      }
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": ["headers", "rows"],
      "properties": {
        "caption": { "type": ["string", "null"], "maxLength": 1000 },
        "headers": { "type": "array", "minItems": 1, "maxItems": 6, "items": { "type": "string", "minLength": 1 } },
        "rows": {
          "type": "array",
          "maxItems": 100,
          "items": { "type": "array", "items": { "type": "string", "maxLength": 5000 } }
        },
        "columnWidthWeights": {
          "type": ["array", "null"],
          "items": { "type": "integer", "minimum": 1, "maximum": 100 }
        }
      }
    },
    "callout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "title", "body"],
      "properties": {
        "kind": { "enum": ["information", "uncertainty", "medicalImportance", "scientificUpdate"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 300 },
        "body": { "type": "string", "minLength": 1, "maxLength": 10000 },
        "audioTimestampSeconds": { "type": ["number", "null"], "minimum": 0 }
      }
    },
    "figure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assetID", "caption", "altText"],
      "properties": {
        "assetID": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,80}$" },
        "caption": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "altText": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "widthPoints": { "type": ["number", "null"], "minimum": 72, "maximum": 468 }
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "sourceIDs"],
      "properties": {
        "type": { "enum": ["paragraph", "bullets", "table", "callout", "figure"] },
        "text": { "type": ["string", "null"], "maxLength": 20000 },
        "items": { "type": ["array", "null"], "maxItems": 100, "items": { "type": "string", "maxLength": 2000 } },
        "table": { "oneOf": [{ "$ref": "#/$defs/table" }, { "type": "null" }] },
        "callout": { "oneOf": [{ "$ref": "#/$defs/callout" }, { "type": "null" }] },
        "figure": { "oneOf": [{ "$ref": "#/$defs/figure" }, { "type": "null" }] },
        "sourceIDs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,80}$" } }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "blocks"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 300 },
        "blocks": { "type": "array", "minItems": 1, "maxItems": 200, "items": { "$ref": "#/$defs/block" } }
      }
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "title", "subtitle", "metadata", "sections"],
      "properties": {
        "kind": { "enum": ["fullCourse", "revisionSheet"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 300 },
        "subtitle": { "type": "string", "minLength": 1, "maxLength": 500 },
        "metadata": { "type": "array", "maxItems": 30, "items": { "$ref": "#/$defs/metadata" } },
        "sections": { "type": "array", "minItems": 1, "maxItems": 80, "items": { "$ref": "#/$defs/section" } }
      }
    }
  }
}
